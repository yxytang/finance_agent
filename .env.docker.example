# Docker Compose configuration example. Keep this file free of credentials.
# Do not overwrite your existing .env.
# Option A: add only needed variables to the existing .env (loaded automatically).
# Option B: copy to .env.docker and use BOTH files:
# docker compose --env-file .env --env-file .env.docker up --build -d
# Keep the same database password after the PostgreSQL volume is initialized.
# Use single quotes around values containing $ in an env file to prevent interpolation.
FINANCE_DB_PASSWORD=
FINANCE_HTTP_PORT=8000

# Existing model/RAG settings are reused from .env. Uncomment only to override.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# RAG_API_KEY=
# RAG_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# RAG_EMBED_MODEL=text-embedding-v4
# RAG_RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RAG_RERANK_MODEL=gte-rerank-v2
# Set RAG_RERANK_MODEL= explicitly to disable reranking.
# KNOWLEDGE_OCR_MODE=auto
# FINANCE_WEB_TOKEN=

# Optional Kafka overlay settings.
# FINANCE_KAFKA_TOPIC=finance.ledger.v1
# FINANCE_KAFKA_GROUP_PREFIX=finance
